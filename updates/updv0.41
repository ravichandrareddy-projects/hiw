//
// ======================= SCANNER SCREEN (camera + emoji) =======================
//

class ScannerScreen extends StatefulWidget {
  final void Function({
    required double healthGain,
    required double energyGain,
    required double staminaGain,
  }) onMockScanResult;

  const ScannerScreen({
    super.key,
    required this.onMockScanResult,
  });

  @override
  State<ScannerScreen> createState() => _ScannerScreenState();
}

class _ScannerScreenState extends State<ScannerScreen>
    with SingleTickerProviderStateMixin {
  CameraController? controller;
  bool cameraReady = false;

  String foodType = "";
  String freshness = "";
  double confidence = 0.0;

  late AnimationController emojiController;
  late Animation<double> emojiScale;

  @override
  void initState() {
    super.initState();

    emojiController = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 800),
    )..repeat(reverse: true);

    emojiScale = Tween<double>(begin: 0.75, end: 1.15).animate(
      CurvedAnimation(parent: emojiController, curve: Curves.easeInOut),
    );

    // Slight delay so activity fully visible before camera opens
    Future.delayed(const Duration(milliseconds: 350), () {
      if (mounted) _initCamera();
    });
  }

  Future<void> _initCamera() async {
    try {
      final cams = await availableCameras();
      controller = CameraController(
        cams.first,
        ResolutionPreset.medium,
        enableAudio: false,
      );
      await controller!.initialize();
      if (!mounted) return;
      setState(() => cameraReady = true);
    } catch (e) {
      debugPrint('Camera error: $e');
      if (mounted) setState(() => cameraReady = false);
    }
  }

  @override
  void dispose() {
    controller?.dispose();
    emojiController.dispose();
    super.dispose();
  }

  Color get glowColor {
    if (freshness == "fresh") return Colors.green.withOpacity(0.35);
    if (freshness == "rotten") return Colors.red.withOpacity(0.35);
    if (foodType == "Healthy") return Colors.teal.withOpacity(0.35);
    if (foodType == "Junk") return Colors.pink.withOpacity(0.35);
    return Colors.grey.withOpacity(0.2);
  }

  String get emoji {
    if (freshness == "fresh") return "😋";
    if (freshness == "rotten") return "🤢";
    if (foodType == "Healthy") return "😊";
    if (foodType == "Junk") return "😞";
    return "🤔";
  }

  void _mockScan() {
    setState(() {
      confidence = 98;

      final results = [
        ["Vegetable", "fresh"],
        ["Vegetable", "rotten"],
        ["Healthy", ""],
        ["Junk", ""],
      ];

      final r = results[DateTime.now().millisecond % results.length];
      foodType = r[0];
      freshness = r[1];

      widget.onMockScanResult(
        healthGain: freshness == "fresh" ? 5 : -2,
        energyGain: freshness == "fresh" ? 4 : -3,
        staminaGain: freshness == "fresh" ? 3 : -2,
      );
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: Container(
        width: double.infinity,
        height: double.infinity,
        decoration: BoxDecoration(
          gradient: LinearGradient(
            begin: Alignment.topCenter,
            end: Alignment.bottomCenter,
            colors: [
              glowColor,
              Colors.black.withOpacity(0.9),
            ],
          ),
        ),
        child: SafeArea(
          child: Center(
            child: Column(
              mainAxisSize: MainAxisSize.max,
              children: [
                const SizedBox(height: 10),
                const Text(
                  "HIW Scanner",
                  style: TextStyle(
                    color: Colors.white,
                    fontSize: 26,
                    fontWeight: FontWeight.bold,
                  ),
                ),
                const SizedBox(height: 10),
                ScaleTransition(
                  scale: emojiScale,
                  child: Text(
                    emoji,
                    style: const TextStyle(fontSize: 48),
                  ),
                ),
                const SizedBox(height: 10),
                Expanded(
                  child: Padding(
                    padding:
                        const EdgeInsets.symmetric(horizontal: 16),
                    child: ClipRRect(
                      borderRadius: BorderRadius.circular(20),
                      child: cameraReady
                          ? CameraPreview(controller!)
                          : Container(
                              color: Colors.black45,
                              child: const Center(
                                child: CircularProgressIndicator(
                                  color: Colors.white,
                                ),
                              ),
                            ),
                    ),
                  ),
                ),
                const SizedBox(height: 12),
                if (foodType.isNotEmpty)
                  _scanGlassBox("Food Type", foodType.toUpperCase()),
                if (freshness.isNotEmpty)
                  _scanGlassBox("Freshness", freshness.toUpperCase()),
                if (confidence > 0)
                  _scanGlassBox(
                      "Confidence", "${confidence.toStringAsFixed(0)}%"),
                const SizedBox(height: 12),
                GestureDetector(
                  onTap: _mockScan,
                  child: ClipOval(
                    child: BackdropFilter(
                      filter: ImageFilter.blur(sigmaX: 10, sigmaY: 10),
                      child: Container(
                        width: 90,
                        height: 90,
                        decoration: BoxDecoration(
                          shape: BoxShape.circle,
                          gradient: LinearGradient(
                            colors: [
                              Colors.white.withOpacity(0.25),
                              Colors.white.withOpacity(0.08),
                            ],
                          ),
                          border: Border.all(
                            color: Colors.white.withOpacity(0.4),
                            width: 3,
                          ),
                        ),
                        child: const Icon(
                          Icons.camera_alt,
                          color: Colors.white,
                          size: 34,
                        ),
                      ),
                    ),
                  ),
                ),
                const SizedBox(height: 20),
              ],
            ),
          ),
        ),
      ),
    );
  }

  Widget _scanGlassBox(String label, String value) {
    return Padding(
      padding:
          const EdgeInsets.symmetric(horizontal: 16, vertical: 5),
      child: ClipRRect(
        borderRadius: BorderRadius.circular(16),
        child: BackdropFilter(
          filter: ImageFilter.blur(sigmaX: 12, sigmaY: 12),
          child: Container(
            padding: const EdgeInsets.all(14),
            decoration: BoxDecoration(
              gradient: LinearGradient(
                colors: [
                  Colors.white.withOpacity(0.18),
                  Colors.white.withOpacity(0.06),
                ],
              ),
              borderRadius: BorderRadius.circular(16),
              border: Border.all(
                color: Colors.white.withOpacity(0.3),
              ),
            ),
            child: Text(
              "$label: $value",
              style: const TextStyle(
                color: Colors.white,
                fontSize: 17,
              ),
            ),
          ),
        ),
      ),
    );
  }
}

