class HistoryScreen extends StatelessWidget {
  final double weeklyHealthy;
  final double weeklyJunk;
  final double monthlyHealthy;
  final double monthlyJunk;
  final double proteinPercent;
  final double carbPercent;
  final double caloriesPercent;

  const HistoryScreen({
    super.key,
    required this.weeklyHealthy,
    required this.weeklyJunk,
    required this.monthlyHealthy,
    required this.monthlyJunk,
    required this.proteinPercent,
    required this.carbPercent,
    required this.caloriesPercent,
  });

  @override
  Widget build(BuildContext context) {
    return ListView(
      padding: const EdgeInsets.all(16),
      children: [
        const Text(
          'HIW History & Stats',
          style: TextStyle(fontSize: 20, fontWeight: FontWeight.bold),
        ),
        const SizedBox(height: 16),
        _pieCard(
          context,
          title: 'Weekly: Healthy vs Junk',
          sections: [
            PieChartSectionData(
              value: weeklyHealthy,
              title: 'Healthy\n${weeklyHealthy.toStringAsFixed(0)}%',
            ),
            PieChartSectionData(
              value: weeklyJunk,
              title: 'Junk\n${weeklyJunk.toStringAsFixed(0)}%',
            ),
          ],
        ),
        _pieCard(
          context,
          title: 'Monthly: Healthy vs Junk',
          sections: [
            PieChartSectionData(
              value: monthlyHealthy,
              title: 'Healthy\n${monthlyHealthy.toStringAsFixed(0)}%',
            ),
            PieChartSectionData(
              value: monthlyJunk,
              title: 'Junk\n${monthlyJunk.toStringAsFixed(0)}%',
            ),
          ],
        ),
        _pieCard(
          context,
          title: 'Approx Nutrition Split (Weekly)',
          sections: [
            PieChartSectionData(
              value: proteinPercent,
              title: 'Protein\n${proteinPercent.toStringAsFixed(0)}%',
            ),
            PieChartSectionData(
              value: carbPercent,
              title: 'Carbs\n${carbPercent.toStringAsFixed(0)}%',
            ),
            PieChartSectionData(
              value: caloriesPercent,
              title: 'Calories\n${caloriesPercent.toStringAsFixed(0)}%',
            ),
          ],
        ),
        const SizedBox(height: 16),
        const Text(
          'Below this you can show list of all scans.\n'
          'Later: link to local DB or API.',
        ),
      ],
    );
  }

  Widget _pieCard(
    BuildContext context, {
    required String title,
    required List<PieChartSectionData> sections,
  }) {
    return Card(
      margin: const EdgeInsets.only(bottom: 16),
      shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(16)),
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          children: [
            Text(title,
                style: const TextStyle(
                    fontWeight: FontWeight.bold, fontSize: 16)),
            const SizedBox(height: 12),
            SizedBox(
              height: 180,
              child: PieChart(
                PieChartData(
                  sectionsSpace: 2,
                  centerSpaceRadius: 30,
                  sections: sections,
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }
}

//
// ======================= AVATAR / SETTINGS / MINIGAME =======================
//

class AvatarScreen extends StatelessWidget {
  final double healthPercent;
  final double energyPercent;
  final double staminaPercent;

  const AvatarScreen({
    super.key,
    required this.healthPercent,
    required this.energyPercent,
    required this.staminaPercent,
  });

  AvatarStage _avatarStage(double percent) {
    if (percent >= 80) return AvatarStage.veryHealthy;
    if (percent >= 60) return AvatarStage.healthy;
    if (percent >= 40) return AvatarStage.normal;
    return AvatarStage.unhealthy;
  }

  @override
  Widget build(BuildContext context) {
    final stage = _avatarStage(healthPercent);

    return Scaffold(
      appBar: AppBar(
        title: const Text('HIW Avatar'),
        centerTitle: true,
        actions: [
          IconButton(
            icon: const Icon(Icons.more_vert),
            onPressed: () {
              Navigator.of(context).push(
                MaterialPageRoute(
                  builder: (_) => const SettingsScreen(),
                ),
              );
            },
          )
        ],
      ),
      body: ListView(
        padding: const EdgeInsets.all(16),
        children: [
          Center(
            child: Stack(
              children: [
                // Placeholder "3D" container – later embed actual GLB viewer
                Container(
                  width: 180,
                  height: 220,
                  decoration: BoxDecoration(
                    borderRadius: BorderRadius.circular(24),
                    gradient: _gradientForStage(stage),
                    border: Border.all(
                      color: Colors.teal.shade700,
                      width: 2,
                    ),
                  ),
                  child: const Center(
                    child: Text(
                      '3D Avatar\n(placeholder)\n\nLater: GLB model\nrotating here.',
                      textAlign: TextAlign.center,
                      style: TextStyle(color: Colors.white),
                    ),
                  ),
                ),
                Positioned(
                  right: 0,
                  bottom: 0,
                  child: FloatingActionButton.small(
                    heroTag: 'game_button',
                    onPressed: () {
                      Navigator.of(context).push(
                        MaterialPageRoute(
                          builder: (_) => const MiniGameScreen(),
                        ),
                      );
                    },
                    child: const Icon(Icons.videogame_asset),
                  ),
                ),
              ],
            ),
          ),
          const SizedBox(height: 16),
          Center(
            child: Text(
              'Health: ${healthPercent.toStringAsFixed(0)}%',
              style: const TextStyle(fontWeight: FontWeight.bold),
            ),
          ),
          Center(
            child: Text('Energy: ${energyPercent.toStringAsFixed(0)}%'),
          ),
          Center(
            child: Text('Stamina: ${staminaPercent.toStringAsFixed(0)}%'),
          ),
          const SizedBox(height: 12),
          Center(
            child: Text(
              'Stage: ${stage.name.toUpperCase()}',
              style: const TextStyle(fontSize: 16),
            ),
          ),
          const SizedBox(height: 16),
          const Text(
            'Later we will:\n'
            '• Replace this box with real 3D GLB avatar\n'
            '• Animate based on health, energy, stamina\n'
            '• Change body, skin glow, clothes, etc.',
            textAlign: TextAlign.left,
          ),
        ],
      ),
    );
  }

  Gradient _gradientForStage(AvatarStage stage) {
    switch (stage) {
      case AvatarStage.unhealthy:
        return const LinearGradient(colors: [Colors.grey, Colors.red]);
      case AvatarStage.normal:
        return const LinearGradient(colors: [Colors.blueGrey, Colors.green]);
      case AvatarStage.healthy:
        return const LinearGradient(colors: [Colors.green, Colors.teal]);
      case AvatarStage.veryHealthy:
        return const LinearGradient(
          colors: [Colors.teal, Colors.lightGreenAccent],
        );
    }
  }
}

enum AvatarStage { unhealthy, normal, healthy, veryHealthy }

